cc_binary {
    name: "roc-resize2fs-static",
    static_executable: true,
    defaults: ["e2fsprogs-defaults"],

    srcs: [
        "extent.c",
        "resize2fs.c",
        "main.c",
        "online.c",
        "sim_progress.c",
        "resource_track.c",
    ],
    static_libs: [
        "libext2fs",
        "libext2_com_err",
        "libext2_e2p",
        "libext2_uuid",
        "libext2_blkid",
    ],
}
