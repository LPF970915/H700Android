on post-fs-data
    exec u:r:init:s0 root root -- /system/bin/sh /vendor/bin/rgsp-input-prepare.sh

on boot
    start rgsp-kmsg-bounded

service rgsp-kmsg-bounded /system/bin/sh /vendor/bin/rgsp-kmsg-start.sh
    class late_start
    user root
    group root log readproc
    seclabel u:r:su:s0
    disabled
