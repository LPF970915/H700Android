# RC2 acceptance: initialize ConfigFS once, retain authenticated USB ADB.
on post-fs-data
    mkdir /config/usb_gadget/g1 0755 root root
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee2
    write /config/usb_gadget/g1/bcdUSB 0x0200
    write /config/usb_gadget/g1/bcdDevice 0x0100
    mkdir /config/usb_gadget/g1/strings/0x409 0755 root root
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer ANBERNIC
    write /config/usb_gadget/g1/strings/0x409/product "ROC OS"
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/functions/mtp.gs0
    write /config/usb_gadget/g1/functions/mtp.gs0/os_desc/interface.MTP/compatible_id MTP
    mkdir /config/usb_gadget/g1/configs/b.1 0755 root root
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0755 root root
    write /config/usb_gadget/g1/configs/b.1/MaxPower 500
    write /config/usb_gadget/g1/os_desc/b_vendor_code 0x1
    write /config/usb_gadget/g1/os_desc/qw_sign MSFT100
    write /config/usb_gadget/g1/os_desc/use 1
    symlink /config/usb_gadget/g1/configs/b.1 /config/usb_gadget/g1/os_desc/b.1
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    chown root mtp /dev/mtp_usb
    chmod 0660 /dev/mtp_usb
    setprop sys.usb.controller 5100000.udc-controller
    setprop sys.usb.configfs 1
    setprop service.adb.tcp.port -1
    setprop persist.adb.tcp.port -1
    setprop persist.sys.usb.config mtp,adb
    setprop sys.usb.config mtp,adb
    start adbd

# Stock legacy USB defaults run on boot. Reassert H700 ConfigFS without
# mounting functionfs a second time or exposing network ADB.
on boot
    setprop sys.usb.configfs 1
    setprop persist.sys.usb.config mtp,adb
    setprop sys.usb.config mtp,adb
