# One read-only Hall endpoint; no sysfs writes or broad sysfs file reads.
type sysfs_roc_hall, fs_type, sysfs_type;
allow platform_app sysfs_roc_hall:file { getattr open read };
# Traverse the newly precise battery parent and class symlink to that endpoint.
# This does not grant reads of other battery files or any sysfs writes.
allow platform_app sysfs_batteryinfo:dir search;
allow platform_app sysfs_batteryinfo:lnk_file { getattr read };
