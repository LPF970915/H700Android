cc_library_shared {
    name: "librgsp_mali_ioctl_trace",
    srcs: ["rgsp_mali_ioctl_trace.c"],
    compile_multilib: "32",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    shared_libs: ["liblog"],
}

cc_binary {
    name: "rgsp_vsync_probe",
    srcs: ["rgsp_vsync_probe.c"],
    vendor: true,
    compile_multilib: "32",
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

cc_binary {
    name: "rgsp_kmsg_logger",
    srcs: ["rgsp_kmsg_logger.c"],
    vendor: true,
    compile_multilib: "32",
    cflags: ["-Wall", "-Wextra", "-Werror"],
    stl: "none",
}
