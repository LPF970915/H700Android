<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.roc.rgsp.navtrial" android:versionCode="6" android:versionName="1.3-controller-mouse">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="29" />
    <application android:label="RGSP D-pad Navigation" android:allowBackup="false">
        <service android:name=".NavigationService" android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/navigation_service" />
        </service>
    </application>
</manifest>
