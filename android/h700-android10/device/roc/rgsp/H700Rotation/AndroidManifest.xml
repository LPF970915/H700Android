<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.roc.rgsp.rotation" android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="29" />
    <uses-permission android:name="android.permission.SET_ORIENTATION" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.STATUS_BAR" />
    <uses-permission android:name="android.permission.DUMP" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application android:label="强制横屏" android:allowBackup="false" android:directBootAware="true"
        android:icon="@drawable/ic_landscape">
        <service android:name=".LandscapeTile" android:label="强制横屏"
            android:icon="@drawable/ic_landscape" android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <receiver android:name=".RotationReceiver" android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="com.roc.rgsp.rotation.PREPARE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
