# An installer must explicitly request this for the current RGSP. No automatic
# provisioning of existing data, no boot-time APK replacement or network setup.
on property:sys.boot_completed=1 && property:sys.rgsp.firstboot=1
    start rgsp-firstboot

service rgsp-firstboot /system/bin/sh /system/bin/rgsp-firstboot.sh apply
    class late_start
    user root
    group root shell log
    seclabel u:r:su:s0
    disabled
    oneshot
