# Only the explicitly labelled, clean-data RG34XXSP release uses this service.
on property:sys.boot_completed=1
    start h700-preinstall

service h700-preinstall /system/bin/sh /system/bin/h700-preinstall.sh apply
    class late_start
    user root
    group root system shell log media_rw sdcard_rw
    seclabel u:r:su:s0
    disabled
    oneshot
