/dev/binder            0666   root       root
/dev/hwbinder          0666   root       root
/dev/vndbinder         0666   root       root
/dev/ion               0666   system     graphics
/dev/mali0             0666   system     graphics
/dev/g2d               0660   system     graphics
/dev/disp              0660   system     graphics
/dev/graphics/fb0      0660   system     graphics
/dev/input/event*     0660   root       input
firmware_directories /vendor/firmware/ /vendor/etc/firmware/ /firmware/image/
