on early-init
    write /rgsp-persist/RGSP_ANDROID_STAGE_LAST.log "early-init"
    setenv LD_LIBRARY_PATH /apex/com.android.adbd/lib64:/apex/com.android.art.release/lib64:/apex/com.android.os.statsd/lib64:/apex/com.android.resolv/lib64:/system/lib64:/apex/com.android.adbd/lib:/apex/com.android.art.release/lib:/apex/com.android.os.statsd/lib:/apex/com.android.resolv/lib:/system/lib
    mount debugfs debugfs /sys/kernel/debug mode=755
    chmod 0755 /sys/kernel/debug
    chmod 0666 /dev/binder
    chmod 0666 /dev/hwbinder
    chmod 0666 /dev/vndbinder
    start rgsp-watch

on init
    write /rgsp-persist/RGSP_ANDROID_STAGE_LAST.log "init"
    setenv LD_LIBRARY_PATH /apex/com.android.adbd/lib64:/apex/com.android.art.release/lib64:/apex/com.android.os.statsd/lib64:/apex/com.android.resolv/lib64:/system/lib64:/apex/com.android.adbd/lib:/apex/com.android.art.release/lib:/apex/com.android.os.statsd/lib:/apex/com.android.resolv/lib:/system/lib
    chmod 0666 /dev/binder
    chmod 0666 /dev/hwbinder
    chmod 0666 /dev/vndbinder
    setprop sys.init_log_level 8
    setprop persist.sys.usb.config adb
    setprop sys.usb.config adb
    setprop persist.adb.tcp.port 5555
    setprop service.adb.tcp.port 5555
    write /proc/sys/vm/swappiness 120
    write /proc/sys/vm/page-cluster 0
    write /sys/block/zram0/comp_algorithm lz4

on fs
    write /rgsp-persist/RGSP_ANDROID_STAGE_LAST.log "fs"
    mount_all /fstab.sun50iw9p1 --early

on late-fs
    write /rgsp-persist/RGSP_ANDROID_STAGE_LAST.log "late-fs"
    mount_all /fstab.sun50iw9p1 --late

on post-fs-data
    write /rgsp-persist/RGSP_ANDROID_STAGE_LAST.log "post-fs-data"
    mkdir /data/misc/adb 02750 system shell
    mkdir /data/adb 0700 root root
    mkdir /data/rgsp-alpha 0755 root root
    setprop vold.post_fs_data_done 1

on boot
    write /rgsp-persist/RGSP_ANDROID_STAGE_LAST.log "boot"
    setprop sys.usb.config adb
    start adbd
    start rgsp-console

on property:sys.boot_completed=1
    write /rgsp-persist/RGSP_ANDROID_STAGE_LAST.log "boot-completed"
    swapon_all /fstab.sun50iw9p1

on property:sys.powerctl=*
    write /rgsp-persist/RGSP_ANDROID_POWERCTL_LAST.log ${sys.powerctl}

service rgsp-watch /system/bin/sh /system/bin/rgsp-boot-watch.sh
    class core
    user root
    group root shell log readproc
    disabled
    oneshot

service rgsp-console /system/bin/sh
    class core
    console
    user root
    group root shell log readproc
    disabled
