# RGSP/H700 Android 11 alpha. The handoff init already uses mmcblk1p2 as
# system-as-root, so Android must not mount that device again at /system.
/dev/mmcblk1p4  /data  ext4  noatime,nosuid,nodev,noauto_da_alloc  wait,latemount,check,formattable,reservedsize=128M

/dev/zram0  none  swap  defaults  zramsize=50%,max_comp_streams=4
