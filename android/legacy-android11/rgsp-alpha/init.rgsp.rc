on early-init
    mount debugfs debugfs /sys/kernel/debug mode=755
    chmod 0755 /sys/kernel/debug

on init
    setprop sys.init_log_level 8
    setprop persist.sys.usb.config adb
    setprop sys.usb.config adb
    write /proc/sys/vm/swappiness 120
    write /proc/sys/vm/page-cluster 0
    write /sys/block/zram0/comp_algorithm lz4

on fs
    mount_all /fstab.rgsp --early

on late-fs
    mount_all /fstab.rgsp --late

on post-fs-data
    mkdir /data/misc/adb 02750 system shell
    mkdir /data/adb 0700 root root
    mkdir /data/rgsp-alpha 0755 root root
    setprop vold.post_fs_data_done 1

on boot
    setprop sys.usb.config adb
    start adbd
    start rgsp-console

on property:sys.boot_completed=1
    swapon_all /fstab.rgsp

service rgsp-console /system/bin/sh
    class core
    console
    user root
    group root shell log readproc
    disabled

