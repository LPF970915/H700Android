#!/bin/sh
set -u

exec </dev/console >/dev/console 2>&1
echo '[rgsp-probe] init reached'
echo "[rgsp-probe] cmdline: $(cat /proc/cmdline 2>/dev/null || true)"
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mkdir -p /dev/pts /dev/shm 2>/dev/null || true
mount -t devpts devpts /dev/pts 2>/dev/null || true
echo '[rgsp-probe] devtmpfs/proc/sys ready'
echo '[rgsp-probe] staying in early userspace; no Android framework is present'

if [ -x /bin/ash ]; then
  exec /bin/ash
fi
while :; do sleep 60; done
