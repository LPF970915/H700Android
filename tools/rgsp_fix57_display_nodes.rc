on post-fs
    # H616 hwcomposer opens this legacy fbdev path, while H700 creates /dev/fb0.
    mkdir /dev/graphics 0770 system graphics
    symlink /dev/fb0 /dev/graphics/fb0
    chown system graphics /dev/fb0
    chmod 0660 /dev/fb0
    chown system graphics /dev/disp
    chmod 0660 /dev/disp
    chown system graphics /dev/ion
    chmod 0660 /dev/ion

on post-fs-data
    chown root root /dev/ashmem
    chmod 0666 /dev/ashmem
    exec u:r:init:s0 root root -- /system/bin/mknod /dev/mali0 c 10 49
    chown system graphics /dev/mali0
    chmod 0666 /dev/mali0
    insmod /system/lib/modules/mali_kbase.ko
    write /sys/power/wake_lock rgsp_android_bringup
