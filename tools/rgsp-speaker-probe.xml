<?xml version="1.0" encoding="utf-8"?>
<!-- Speaker-only runtime probe. Headphones/capture/HDMI are not qualified. -->
<mixer>
    <ctl name="SPK Switch" value="0" />
    <ctl name="LINEOUT Switch" value="0" />
    <ctl name="OutputL Mixer DACL Switch" value="0" />
    <ctl name="OutputL Mixer DACR Switch" value="0" />
    <ctl name="OutputR Mixer DACL Switch" value="0" />
    <ctl name="OutputR Mixer DACR Switch" value="0" />
    <path name="media-speaker">
        <ctl name="OutputL Mixer DACL Switch" value="1" />
        <ctl name="OutputR Mixer DACR Switch" value="1" />
        <ctl name="LINEOUT Switch" value="1" />
        <ctl name="SPK Switch" value="1" />
    </path>
    <path name="media-single-speaker">
        <path name="media-speaker" />
    </path>
    <path name="null" />
</mixer>
